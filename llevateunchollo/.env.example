# ─── BASE DE DATOS ────────────────────────────────────────────────────────────
# Local (SQLite):
DATABASE_URL="file:./dev.db"
# Producción (Supabase / PostgreSQL):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/llevateunchollo?sslmode=require"

# ─── NEXTAUTH ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="https://www.llevateunchollo.es"
# Genera un secreto seguro con: openssl rand -base64 32
NEXTAUTH_SECRET="CAMBIA_ESTO_POR_UN_SECRETO_SEGURO_32_CHARS"

# ─── STRIPE ───────────────────────────────────────────────────────────────────
# Claves disponibles en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# ─── WHATSAPP ─────────────────────────────────────────────────────────────────
# Número en formato internacional sin + (ej: España 34 + número sin 0)
NEXT_PUBLIC_WHATSAPP_NUMBER="34600000000"

# ─── SITIO ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://www.llevateunchollo.es"
